{
  "functions": [
    {
      "source": "functions",
      "codebase": "repartos-chema",
      "runtime": "nodejs22",
      "predeploy": ["npm --prefix functions run build"]
    }
  ],
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "functions": { "port": 5001 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
