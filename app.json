{
  "expo": {
    "name": "Chema Andamios",
    "slug": "chema-andamios",
    "scheme": "repartoschema",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grupochema.repartos"
    },
    "android": {
      "package": "com.grupochema.repartos",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.c2dm.permission.RECEIVE",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ],
      "versionCode": 19,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/adaptive-foreground.png",
        "backgroundColor": "#C91824"
      },
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Chema Andamios",
      "favicon": "./assets/app/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir fotos para documentar entregas y retiros.",
          "cameraPermission": "Permitir cámara para documentar materiales.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usar tu ubicación al ordenar el viaje."
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      "expo-system-ui",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/chema_recordatorio_calido.wav",
            "./assets/sounds/chema_confirmacion_sutil.wav",
            "./assets/sounds/chema_atencion_suave.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/app/icon.png"
  }
}
