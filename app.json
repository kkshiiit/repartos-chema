{
  "expo": {
    "name": "Repartos Chema",
    "slug": "repartos-chema",
    "scheme": "repartoschema",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grupochema.repartos"
    },
    "android": {
      "package": "com.grupochema.repartos",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Repartos Chema"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir fotos para documentar entregas y retiros.",
          "cameraPermission": "Permitir cámara para documentar materiales.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usar tu ubicación al ordenar el viaje."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
