{
  "name": "repartos-chema",
  "version": "1.7.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src tests functions/src",
    "test": "vitest run",
    "build:web": "node scripts/build-web-local.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm --prefix functions run build",
    "test:integration": "firebase emulators:exec --project demo-repartos-chema --only firestore,storage \"vitest run --config vitest.integration.config.mts\"",
    "preview": "node scripts/serve.mjs",
    "test:ui": "playwright test",
    "format": "prettier --write app src functions/src tests docs scripts *.json *.md *.ts *.mts *.js",
    "build:android:demo": "node scripts/build-android-demo.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "buffer": "^6.0.3",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "docx": "^9.9.0",
    "exceljs": "^4.4.0",
    "expo": "~57.0.30",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^13.0.0",
    "lucide-react-native": "^1.54.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "firebase-tools": "^15.33.0",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "decode-uri-component": "$decode-uri-component"
  }
}
