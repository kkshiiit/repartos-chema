# demo funciona sin credenciales. firebase exige configurar y desplegar el backend.
EXPO_PUBLIC_DATA_MODE=demo
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1
# FCM web opcional: clave pública VAPID, nunca una clave privada.
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
# Completar public/firebase-messaging-sw.js con la configuración pública antes de activar push web.

# Publicidad optativa: none | admob | sponsor. Requiere activación en Configuración.
EXPO_PUBLIC_ADS_PROVIDER=none
EXPO_PUBLIC_ADS_TEST_MODE=true
# IDs reales solo en tu .env, obtenidos de tu propia cuenta AdMob.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
# Alternativa para patrocinio directo (web y móvil). Sin rastreo integrado.
EXPO_PUBLIC_SPONSOR_NAME=
EXPO_PUBLIC_SPONSOR_TEXT=
EXPO_PUBLIC_SPONSOR_URL=
