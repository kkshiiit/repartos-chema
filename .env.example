# demo funciona sin credenciales. firebase exige configurar y desplegar el backend.
EXPO_PUBLIC_DATA_MODE=demo
# Entrega individual: inicia vacío solo si aún no existen datos locales.
EXPO_PUBLIC_LOCAL_ONLY=true
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1
# FCM web opcional: clave pública VAPID, nunca una clave privada.
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
# Los workers se generan desde src/workers al compilar.
