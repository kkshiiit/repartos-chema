rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
  function member() { return request.auth != null && profile().get('active', true) != false && profile().role in ['ADMIN', 'OPERADOR'] && ((profile().get('teamAccess',false) == true && profile().get('active',false) == true) || request.auth.token.get('email_verified',false) == true); }
  function admin() { return member() && profile().role == 'ADMIN'; }
  match /users/{uid} { allow read: if request.auth != null && (request.auth.uid == uid || admin()); allow write: if false; }
  match /system/state { allow read: if member(); allow write: if false; }
  match /audit/{id} { allow read: if admin(); allow write: if false; }
  match /notifications/{id} { allow read: if admin(); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
